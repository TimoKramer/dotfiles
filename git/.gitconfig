[user]
    name = Timo Kramer
    signingkey = 8D18DC61069781F6
[include]
    path = ~/.gitconfig.private
[push]
    autoSetupRemote = true
	default = nothing
[pull]
    rebase = true
[core]
    excludesfile = ~/.gitignore
    eol = lf
    autocrlf = false
[alias]
    s = status
    l = "--graph --oneline --pretty=\"format:%h %G? %aN  %s\"'"
    f = "fetch --all"
    d = diff
    c = "commit -S"
[gpg]
    program = gpg
[commit]
    gpgsign = true
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
